# Copy to .env and fill in real values.
#
# For local development, put overrides in .env.local instead. It is loaded
# first and takes precedence, so you never have to edit the production .env.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Required when DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default if unset):
# DATABASE_URL=sqlite:///db.sqlite3
# MariaDB / MySQL:
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ai_code_reviewer
# PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/ai_code_reviewer

# ---------------------------------------------------------------------------
# GitHub OAuth (per-user "Connect GitHub")
# ---------------------------------------------------------------------------
# https://github.com/settings/developers -> OAuth App
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback/

# Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes every already-stored GitHub access token undecryptable,
# so users have to reconnect GitHub.
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# GitHub App (webhook-triggered reviews and PR comments)
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Either paste the PEM inline, replacing newlines with \n, ...
GITHUB_PRIVATE_KEY=
# ... or point at a file on disk.
GITHUB_PRIVATE_KEY_PATH=

# Secret configured on the GitHub App's webhook, used to verify that
# incoming deliveries really came from GitHub.
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI provider (Groq, OpenAI-compatible API)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# Email (account verification codes)
# ---------------------------------------------------------------------------
# Defaults to the console backend, which prints codes to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# ---------------------------------------------------------------------------
# Frontend and CORS
#
# Comma-separated. List BOTH localhost and 127.0.0.1 for the Vite dev server:
# the browser sends the Origin header verbatim, so an origin that is missing
# here is blocked and the UI only shows a generic failure.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173/
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Transport security
#
# These only matter in production. The settings module refuses to start
# with DEBUG=False unless SECURE_SSL_REDIRECT, the Secure cookie flags and
# SECURE_HSTS_SECONDS (>= 31536000) are all enabled.
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Cross-site deployments need SameSite=None, which browsers only accept
# together with Secure. Localhost (same host, different port) stays on Lax.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Reverse proxy scheme header, e.g. "HTTP_X_FORWARDED_PROTO https".
# Leave empty when not behind a proxy.
SECURE_PROXY_SSL_HEADER=
